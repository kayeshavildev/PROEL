
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learning Task 5.1 - SVG Art</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f8f8;
            text-align: center;
            margin: 20px;
        }

        h1 {
            color: #333;
        }

        .gallery {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .art {
            background: white;
            padding: 10px;
            border: 2px solid #ff9189;
            box-shadow: 2px 2px 5px #ccc;
        }

        svg {
            width: 200px;
            height: 300px;
            display: block;
        }

        h3 {
            font-size: 14px;
            color: #444;
        }
    </style>
</head>

<body>

<h1>Learning Task 5.1: SVG Graphical Art</h1>

<div class="gallery">

    <!-- 1. Line and Circle -->
    <div class="art">
        <svg viewBox="0 0 200 300">
            <rect width="200" height="300" fill="#fff"/>
            <g stroke="#ff9189" stroke-width="5" fill="none">
                <path d="M20 60 H180 M50 30 V260 M20 150 H180 M150 30 V260"/>
                <circle cx="55" cy="60" r="32"/>
                <circle cx="145" cy="60" r="32"/>
                <circle cx="100" cy="150" r="32"/>
                <circle cx="55" cy="240" r="32"/>
                <circle cx="145" cy="240" r="32"/>
            </g>
            <g fill="#12b5b0">
                <circle cx="55" cy="60" r="20"/>
                <circle cx="145" cy="60" r="20"/>
                <circle cx="100" cy="150" r="20"/>
                <circle cx="55" cy="240" r="20"/>
                <circle cx="145" cy="240" r="20"/>
            </g>
        </svg>
        <h3>1. Line and Circle</h3>
    </div>

    <!-- 2. Circle and Rectangle -->
    <div class="art">
        <svg viewBox="0 0 200 300">
            <rect width="200" height="300" fill="#12b5b0"/>
            <g fill="#ff9189">
                <rect x="0" y="0" width="200" height="95"/>
                <rect x="0" y="103" width="200" height="94"/>
                <rect x="0" y="205" width="200" height="95"/>
            </g>
            <g fill="#12b5b0">
                <circle cx="35" cy="45" r="12"/>
                <circle cx="100" cy="45" r="12"/>
                <circle cx="165" cy="45" r="12"/>
                <circle cx="70" cy="70" r="12"/>
                <circle cx="135" cy="70" r="12"/>

                <circle cx="35" cy="148" r="12"/>
                <circle cx="100" cy="148" r="12"/>
                <circle cx="165" cy="148" r="12"/>
                <circle cx="70" cy="173" r="12"/>
                <circle cx="135" cy="173" r="12"/>

                <circle cx="35" cy="250" r="12"/>
                <circle cx="100" cy="250" r="12"/>
                <circle cx="165" cy="250" r="12"/>
                <circle cx="70" cy="275" r="12"/>
                <circle cx="135" cy="275" r="12"/>
            </g>
        </svg>
        <h3>2. Circle and Rectangle</h3>
    </div>

    <!-- 3. Polyline and Circle -->
    <div class="art">
        <svg viewBox="0 0 200 300">
            <rect width="200" height="300" fill="white"/>

            <g fill="none" stroke-width="12">
                <polyline points="0,35 35,5 70,35 105,5 140,35 175,5 210,35"
                    stroke="#12b5b0"/>
                <polyline points="0,95 35,65 70,95 105,65 140,95 175,65 210,95"
                    stroke="#ffcf35"/>
                <polyline points="0,155 35,125 70,155 105,125 140,155 175,125 210,155"
                    stroke="#ff9189"/>
                <polyline points="0,215 35,185 70,215 105,185 140,215 175,185 210,215"
                    stroke="#12b5b0"/>
                <polyline points="0,275 35,245 70,275 105,245 140,275 175,245 210,275"
                    stroke="#ffcf35"/>
            </g>

            <g fill="#bdb3b0">
                <circle cx="35" cy="65" r="13"/>
                <circle cx="105" cy="65" r="13"/>
                <circle cx="175" cy="65" r="13"/>
                <circle cx="35" cy="125" r="13"/>
                <circle cx="105" cy="125" r="13"/>
                <circle cx="175" cy="125" r="13"/>
                <circle cx="35" cy="185" r="13"/>
                <circle cx="105" cy="185" r="13"/>
                <circle cx="175" cy="185" r="13"/>
            </g>
        </svg>
        <h3>3. Polyline and Circle</h3>
    </div>

    <!-- 4. Polygon and Ellipse -->
    <div class="art">
        <svg viewBox="0 0 200 300">
            <rect width="200" height="300" fill="white"/>

            <g stroke-width="12">
                <polygon points="0,20 35,55 70,20 105,55 140,20 175,55 210,20"
                    fill="#12b5b0"/>
                <polygon points="0,85 35,120 70,85 105,120 140,85 175,120 210,85"
                    fill="#ffcf35"/>
                <polygon points="0,150 35,185 70,150 105,185 140,150 175,185 210,150"
                    fill="#ff9189"/>
                <polygon points="0,215 35,250 70,215 105,250 140,215 175,250 210,215"
                    fill="#12b5b0"/>
            </g>

            <g fill="#bdb3b0">
                <ellipse cx="10" cy="110" rx="22" ry="35"/>
                <ellipse cx="75" cy="110" rx="22" ry="35"/>
                <ellipse cx="140" cy="110" rx="22" ry="35"/>
                <ellipse cx="205" cy="110" rx="22" ry="35"/>
            </g>
        </svg>
        <h3>4. Polygon and Ellipse</h3>
    </div>

    <!-- 5. Line, Rectangle and Circle -->
    <div class="art">
        <svg viewBox="0 0 200 300">
            <rect width="200" height="300" fill="#12b5b0"/>

            <g stroke="#ff9189" stroke-width="5" fill="none">
                <rect x="5" y="10" width="190" height="80"/>
                <rect x="5" y="110" width="190" height="80"/>
                <rect x="5" y="210" width="190" height="80"/>
                <path d="M20 10 V290 M60 10 V290 M100 10 V290 M140 10 V290 M180 10 V290"/>
            </g>

            <g fill="#ff9189">
                <circle cx="20" cy="45" r="11"/>
                <circle cx="60" cy="45" r="11"/>
                <circle cx="100" cy="45" r="11"/>
                <circle cx="140" cy="45" r="11"/>
                <circle cx="180" cy="45" r="11"/>

                <circle cx="20" cy="150" r="11"/>
                <circle cx="60" cy="150" r="11"/>
                <circle cx="100" cy="150" r="11"/>
                <circle cx="140" cy="150" r="11"/>
                <circle cx="180" cy="150" r="11"/>

                <circle cx="20" cy="250" r="11"/>
                <circle cx="60" cy="250" r="11"/>
                <circle cx="100" cy="250" r="11"/>
                <circle cx="140" cy="250" r="11"/>
                <circle cx="180" cy="250" r="11"/>
            </g>
        </svg>
        <h3>5. Line, Rectangle and Circle</h3>
    </div>

    <!-- 6. Polyline and Polygon -->
    <div class="art">
        <svg viewBox="0 0 200 300">
            <rect width="200" height="300" fill="#ff9189"/>

            <polygon points="0,0 200,0 160,50 200,100 160,150 200,200 160,250 200,300 0,300 40,250 0,200 40,150 0,100 40,50"
                fill="#12b5b0"/>

            <g fill="none" stroke="#12b5b0" stroke-width="12">
                <polyline points="0,30 35,65 0,100 35,135 0,170 35,205 0,240 35,275"/>
                <polyline points="200,30 165,65 200,100 165,135 200,170 165,205 200,240 165,275"/>
            </g>
        </svg>
        <h3>6. Polyline and Polygon</h3>
    </div>

    <!-- 7. All SVG Shapes -->
    <div class="art">
        <svg viewBox="0 0 200 300">
            <rect width="200" height="300" fill="#12b5b0"/>

            <!-- Rectangle -->
            <rect x="5" y="5" width="190" height="110"
                fill="#12b5b0" stroke="#ff9189" stroke-width="5"/>

            <!-- Lines -->
            <g stroke="#ff9189" stroke-width="4">
                <path d="M30 5 V90 M70 5 V90 M110 5 V90 M150 5 V90"/>
            </g>

            <!-- Circles -->
            <g fill="#ff9189">
                <circle cx="30" cy="65" r="16"/>
                <circle cx="70" cy="85" r="16"/>
                <circle cx="110" cy="65" r="16"/>
                <circle cx="150" cy="85" r="16"/>
            </g>

            <circle cx="100" cy="145" r="28" fill="#bdb3b0"/>

            <!-- Polyline -->
            <polyline points="0,185 35,150 70,185 105,150 140,185 175,150 210,185"
                fill="none" stroke="#ff9189" stroke-width="13"/>

            <!-- Polygon -->
            <polygon points="0,215 35,185 70,215 105,185 140,215 175,185 210,215"
                fill="#bdb3b0"/>

            <!-- Ellipses -->
            <g fill="#ff9189">
                <ellipse cx="35" cy="260" rx="28" ry="23"/>
                <ellipse cx="100" cy="260" rx="20" ry="32"/>
                <ellipse cx="165" cy="260" rx="28" ry="23"/>
            </g>
        </svg>
        <h3>7. Combination of All Shapes</h3>
    </div>

</div>

</body>
</html>
